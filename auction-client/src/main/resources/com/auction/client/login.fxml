<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.auction.client.controller.LoginController" styleClass="auth-root">
  <top><HBox alignment="CENTER_RIGHT" styleClass="auth-top" spacing="8">
    <Label text="●" styleClass="live-dot"/>
    <Label fx:id="endpointLabel" styleClass="endpoint"/>
  </HBox></top>
  <center><HBox alignment="CENTER" spacing="0" maxWidth="850" maxHeight="470" BorderPane.alignment="CENTER" styleClass="auth-card">
    <VBox prefWidth="440" alignment="CENTER_LEFT" spacing="15" styleClass="auth-form">
      <Label text="AUCTIVA" styleClass="logo-dark"/>
      <Label text="Chào mừng trở lại" styleClass="auth-title"/>
      <Label text="Đăng nhập để khám phá phiên đấu giá." styleClass="muted"/>
      <Region prefHeight="7"/>
      <Label text="TÊN TÀI KHOẢN" styleClass="field-label"/>
      <TextField fx:id="usernameField" promptText="Nhập tài khoản (3–24 ký tự)" styleClass="auth-input"/>
      <Label text="MẬT KHẨU" styleClass="field-label"/>
      <PasswordField fx:id="passwordField" promptText="Nhập mật khẩu" styleClass="auth-input"/>
      <Label text="VAI TRÒ KHI ĐĂNG KÝ" styleClass="field-label"/>
      <ComboBox fx:id="roleChoice" maxWidth="Infinity" styleClass="auth-input"/>
      <HBox spacing="10"><Button fx:id="loginButton" text="Đăng nhập" onAction="#login" defaultButton="true" styleClass="primary-btn" prefWidth="170"/><Button fx:id="registerButton" text="Tạo tài khoản" onAction="#register" styleClass="outline-btn" prefWidth="170"/></HBox>
      <Label fx:id="messageLabel" text="" wrapText="true" styleClass="error-label"/>
      <Label text="Tài khoản quản trị được tạo riêng ở server." styleClass="hint"/>
    </VBox>
    <VBox prefWidth="410" alignment="CENTER_LEFT" spacing="17" styleClass="auth-hero">
      <Label text="THE NEXT BID IS YOURS" styleClass="hero-eyebrow"/>
      <Label text="Đấu giá thông minh.
Minh bạch theo
thời gian thực." styleClass="hero-title" wrapText="true"/>
      <Region prefHeight="12"/>
      <Label text="◆  Đặt giá đồng thời an toàn" styleClass="hero-feature"/>
      <Label text="◆  Đấu giá tự động theo giới hạn" styleClass="hero-feature"/>
      <Label text="◆  Biểu đồ giá cập nhật ngay lập tức" styleClass="hero-feature"/>
      <Region prefHeight="50"/>
      <Label text="AUCTION LAB  /  LTNC 2026" styleClass="hero-footer"/>
    </VBox>
  </HBox></center>
  <bottom><HBox alignment="CENTER" styleClass="auth-footer"><Label text="JavaFX • Socket • Observer • Maven Multi-module" styleClass="muted"/></HBox></bottom>
</BorderPane>
